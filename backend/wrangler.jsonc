{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waitly-api",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waitly-db",
      "database_id": "a9ee6820-92d5-4114-bf99-4e2f72917779"
    }
  ],
  "secrets": {
    "required": ["CORS_ORIGIN", "JWT_SECRET", "ADMIN_SECRET"]
  },
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "da8aacd638a34f40967660028f35d907",
      "secret_name": "RESEND_API_KEY"
    }
  ]
}
